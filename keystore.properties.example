# Copy this file to keystore.properties (repo root, gitignored) and fill in real values to
# produce a signed release build. Never commit the real keystore.properties or the .jks/.keystore
# file it points to — both must stay out of version control.
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore sultan-release.keystore -alias sultan-release \
#     -keyalg RSA -keysize 2048 -validity 10000

storeFile=/absolute/path/to/sultan-release.keystore
storePassword=CHANGE_ME
keyAlias=sultan-release
keyPassword=CHANGE_ME
