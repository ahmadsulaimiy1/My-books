# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is already in .gitignore.
# No secrets are hard-coded anywhere in this codebase; everything reads from these variables.

# --- Firebase (Web SDK config — safe to expose client-side, but keep out of git history anyway) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Future payment gateway (placeholder — not implemented yet) ---
PAYMENT_GATEWAY_SECRET_KEY=
PAYMENT_GATEWAY_PUBLIC_KEY=

# --- Future email/SMS/WhatsApp providers (placeholders — not implemented yet) ---
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_API_KEY=
