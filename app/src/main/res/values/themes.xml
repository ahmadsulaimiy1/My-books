<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme; Compose (ui/theme/Theme.kt) owns all in-app styling. -->
    <style name="Theme.SultanArabicAI" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/royal_navy_deep</item>
        <item name="android:navigationBarColor">@color/royal_navy_deep</item>
        <item name="android:windowBackground">@color/royal_navy_deep</item>
    </style>

    <!-- Splash theme: royal navy field, gold monogram, per androidx.core.splashscreen contract. -->
    <style name="Theme.SultanArabicAI.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/royal_navy_deep</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.SultanArabicAI</item>
    </style>

</resources>
